# systemd unit for the display on a Raspberry Pi: Chromium in kiosk mode under the cage compositor, on tty1.
# Install:  copy kiosk.html and blank_cursor.py to ~/claude-home/satellite/, then
#           python3 ~/claude-home/satellite/blank_cursor.py   (as claude-pi: hides cage's cursor)
#           sudo apt install wlr-randr
#           sudo cp touch-rotate.rules /etc/udev/rules.d/99-touch-rotate.rules && sudo udevadm trigger
#           sudo cp claude-home-display.service /etc/systemd/system/
#           sudo systemctl disable --now getty@tty1
#           sudo systemctl enable --now claude-home-display
# Logs:     journalctl -u claude-home-display -f
# Screenshot (as claude-pi): XDG_RUNTIME_DIR=/run/user/1000 WAYLAND_DISPLAY=wayland-0 grim shot.png
#
# It starts on kiosk.html, which waits for the brain and then opens the display page, so the Pi can boot
# before the brain PC is up. Change the brain address after the '#' (and the device name) as needed.
[Unit]
Description=Claude Home display (Chromium kiosk)
After=network-online.target systemd-user-sessions.service getty@tty1.service
Wants=network-online.target
Conflicts=getty@tty1.service

[Service]
User=claude-pi
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty-force
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
# Clock and date format: Raspberry Pi OS defaults to en-GB (24-hour, day before month).
Environment=LANG=en_US.UTF-8 LANGUAGE=en_US
# The Touch Display 2 is a portrait panel mounted landscape: cage has no rotate option, so wlr-randr turns
# it 90 degrees counter-clockwise first. Touch is turned to match by touch-rotate.rules.
# shortcut: temporary boot logging (cage -D, the output before and after rotating, a screenshot 20 s in at
# /tmp/kiosk-boot.png) to find why a cold boot lays the page out too big; remove once that's fixed.
ExecStart=/usr/bin/cage -D -- /bin/sh -c 'echo "kiosk: output before rotating"; wlr-randr; \
    wlr-randr --output DSI-1 --transform 90; echo "kiosk: rotate exited $$?"; wlr-randr; \
    (sleep 20; grim /tmp/kiosk-boot.png; echo "kiosk: output 20 s after starting Chromium"; wlr-randr) & \
    echo "kiosk: starting Chromium"; \
    exec /usr/bin/chromium --kiosk --noerrdialogs --no-first-run --disable-infobars \
    --ozone-platform=wayland --password-store=basic --disable-features=Translate \
    --check-for-update-interval=31536000 \
    "file:///home/claude-pi/claude-home/satellite/kiosk.html#http://192.168.0.172:8765/display/?device=claude-pi"'
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
